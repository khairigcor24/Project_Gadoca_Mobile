<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gadoca_background"
    tools:context=".MenuActivity">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@color/gadoca_surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/gambargadoca"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Gadoca"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="@color/gadoca_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notification_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notification" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diracik untuk harimu."
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="@color/gadoca_text_dark"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Temukan teman untuk setiap suasana."
                android:textSize="13sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginBottom="16dp" />

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cari menu"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxStrokeColor="@color/gadoca_primary"
                app:hintTextColor="@color/gadoca_primary"
                app:startIconDrawable="@drawable/ic_search_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category Chips Horizontal Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1: Semua (Active) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Semua"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_chip_active"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 2: Kopi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Kopi"
                        android:textSize="13sp"
                        android:textColor="@color/gadoca_text_dark"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 3: Pastry -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Pastry"
                        android:textSize="13sp"
                        android:textColor="@color/gadoca_text_dark"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 4: Minuman -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Minuman"
                        android:textSize="13sp"
                        android:textColor="@color/gadoca_text_dark"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 5: Roti -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Roti"
                        android:textSize="13sp"
                        android:textColor="@color/gadoca_text_dark"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 6: Makanan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Makanan"
                        android:textSize="13sp"
                        android:textColor="@color/gadoca_text_dark"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 7: Snack -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Snack"
                        android:textSize="13sp"
                        android:textColor="@color/gadoca_text_dark"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section: Pilihan kami -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pilihan kami"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/gadoca_text_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 menu pilihan"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/gadoca_primary" />
            </LinearLayout>

            <!-- Product Grid Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Product 1: Es Kopi Gula Aren -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB"
                    app:cardBackgroundColor="@color/gadoca_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:src="@drawable/img_coffee_banner"
                            android:scaleType="centerCrop"
                            android:contentDescription="Es Kopi" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Es Kopi Gula Aren"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_text_dark"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kopi · Favorit pelanggan"
                                android:textSize="10sp"
                                android:textColor="@color/gadoca_text_muted"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Rp28.000"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gadoca_primary" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_add_24"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Add" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Product 2: Cappuccino -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB"
                    app:cardBackgroundColor="@color/gadoca_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:src="@drawable/img_coffee_banner"
                            android:scaleType="centerCrop"
                            android:contentDescription="Cappuccino" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cappuccino"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_text_dark"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kopi · Lembut &amp; seimbang"
                                android:textSize="10sp"
                                android:textColor="@color/gadoca_text_muted"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Rp30.000"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gadoca_primary" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_add_24"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Add" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Product Grid Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Product 3: Butter Croissant -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB"
                    app:cardBackgroundColor="@color/gadoca_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:src="@drawable/img_coffee_banner"
                            android:scaleType="centerCrop"
                            android:contentDescription="Croissant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Butter Croissant"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_text_dark"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Pastry · Dipanggang harian"
                                android:textSize="10sp"
                                android:textColor="@color/gadoca_text_muted"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Rp24.000"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gadoca_primary" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_add_24"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Add" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Product 4: Matcha Latte -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB"
                    app:cardBackgroundColor="@color/gadoca_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:src="@drawable/img_coffee_banner"
                            android:scaleType="centerCrop"
                            android:contentDescription="Matcha" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Matcha Latte"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_text_dark"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Minuman · Matcha premium"
                                android:textSize="10sp"
                                android:textColor="@color/gadoca_text_muted"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Rp32.000"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gadoca_primary" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_add_24"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Add" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Footer Note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menu &amp; harga contoh untuk konsep proyek Gadoca."
                android:textSize="11sp"
                android:textColor="@color/gadoca_text_muted"
                android:gravity="center"
                android:paddingBottom="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar (Menu Active) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/gadoca_surface"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <!-- Tab 1: Beranda -->
        <LinearLayout
            android:id="@+id/tabBeranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home_24"
                android:contentDescription="Beranda" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beranda"
                android:textSize="10sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 2: Menu (Active) -->
        <LinearLayout
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_tab_24"
                android:contentDescription="Menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/gadoca_primary"
                android:layout_marginTop="2dp" />

            <!-- Active dot -->
            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_indicator_active"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 3: Pesanan -->
        <LinearLayout
            android:id="@+id/tabPesanan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_orders_24"
                android:contentDescription="Pesanan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesanan"
                android:textSize="10sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 4: Akun -->
        <LinearLayout
            android:id="@+id/tabAkun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile_24"
                android:contentDescription="Akun" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akun"
                android:textSize="10sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
