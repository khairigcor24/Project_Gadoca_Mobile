<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gadoca_background"
    tools:context=".MenuCrudActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMenuCrud"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gadoca_surface"
        app:title="Manajemen Menu (Supabase)"
        app:titleTextColor="@color/gadoca_text_dark"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMenus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_margin="20dp"
        android:text="Tambah Menu"
        android:textColor="@color/white"
        app:backgroundTint="@color/gadoca_primary"
        app:icon="@drawable/ic_add_24"
        app:iconTint="@color/white" />

</LinearLayout>
