<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB"
    app:cardBackgroundColor="@color/gadoca_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivGridItem"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/gambargadoca"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:contentDescription="Grid Item" />

        <TextView
            android:id="@+id/tvGridTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Es Kopi"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/gadoca_text_dark"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvGridSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp28.000"
            android:textSize="11sp"
            android:textColor="@color/gadoca_primary"
            android:gravity="center"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
