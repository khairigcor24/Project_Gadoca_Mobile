<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gadoca_background"
    tools:context=".SearchFilterActivity">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSearch"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gadoca_surface"
        app:title="Cari favoritmu"
        app:titleTextColor="@color/gadoca_text_dark"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:menu="@menu/menu_secondary" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Pencarian Label & Search Box -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pencarian"
                android:textSize="12sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxStrokeColor="@color/gadoca_primary"
                app:hintTextColor="@color/gadoca_primary"
                app:startIconDrawable="@drawable/ic_search_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchQuery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="kopi"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sesuaikan Pilihan Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                app:cardBackgroundColor="@color/gadoca_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header inside card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sesuaikan pilihan"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="serif"
                            android:textColor="@color/gadoca_text_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Atur ulang"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/gadoca_primary" />
                    </LinearLayout>

                    <!-- Kategori Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kategori"
                        android:textSize="11sp"
                        android:textColor="@color/gadoca_text_muted"
                        android:layout_marginBottom="8dp" />

                    <!-- Kategori Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <!-- Kopi (Active) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Kopi"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_chip_active"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Minuman -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Minuman"
                            android:textSize="12sp"
                            android:textColor="@color/gadoca_text_dark"
                            android:background="@drawable/bg_chip_inactive"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Pastry -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Pastry"
                            android:textSize="12sp"
                            android:textColor="@color/gadoca_text_dark"
                            android:background="@drawable/bg_chip_inactive"
                            android:gravity="center"
                            android:paddingHorizontal="18dp" />
                    </LinearLayout>

                    <!-- Rentang harga Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rentang harga"
                        android:textSize="11sp"
                        android:textColor="@color/gadoca_text_muted"
                        android:layout_marginBottom="8dp" />

                    <!-- Rentang harga Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- Semua harga -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Semua harga"
                            android:textSize="12sp"
                            android:textColor="@color/gadoca_text_dark"
                            android:background="@drawable/bg_chip_inactive"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp" />

                        <!-- <= Rp35.000 (Active) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="≤ Rp35.000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_chip_active"
                            android:gravity="center"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="12dp" />

                    <!-- Switch row: Hanya minuman dingin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hanya minuman dingin"
                            android:textSize="13sp"
                            android:textColor="@color/gadoca_text_dark" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/gadoca_primary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Results Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3 hasil untuk “kopi”"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/gadoca_text_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terpopuler ↓"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/gadoca_primary" />
            </LinearLayout>

            <!-- Results List Card (Containing 3 items with dividers) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                app:cardBackgroundColor="@color/gadoca_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Item 1: Es Kopi Gula Aren -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_coffee_banner"
                                android:scaleType="centerCrop"
                                android:contentDescription="Item 1" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Es Kopi Gula Aren"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_text_dark" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kopi · Dingin · Terlaris"
                                android:textSize="11sp"
                                android:textColor="@color/gadoca_text_muted"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Rp28.000"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider 1 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="12dp" />

                    <!-- Item 2: Es Americano -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_coffee_banner"
                                android:scaleType="centerCrop"
                                android:contentDescription="Item 2" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Es Americano"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_text_dark" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kopi · Dingin · Tanpa susu"
                                android:textSize="11sp"
                                android:textColor="@color/gadoca_text_muted"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Rp24.000"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="12dp" />

                    <!-- Item 3: Es Cappuccino -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_coffee_banner"
                                android:scaleType="centerCrop"
                                android:contentDescription="Item 3" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Es Cappuccino"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_text_dark" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kopi · Dingin · Lembut"
                                android:textSize="11sp"
                                android:textColor="@color/gadoca_text_muted"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Rp30.000"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gadoca_primary" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Info Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/gadoca_secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_filter_24"
                        android:contentDescription="Filter Info" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Menampilkan pilihan sesuai kategori, harga, dan suhu minuman."
                        android:textSize="12sp"
                        android:textColor="@color/gadoca_text_dark"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar (Menu Active) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/gadoca_surface"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <!-- Tab 1: Beranda -->
        <LinearLayout
            android:id="@+id/tabBeranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home_24"
                android:contentDescription="Beranda" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beranda"
                android:textSize="10sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 2: Menu (Active) -->
        <LinearLayout
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_tab_24"
                android:contentDescription="Menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/gadoca_primary"
                android:layout_marginTop="2dp" />

            <!-- Active dot -->
            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_indicator_active"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 3: Pesanan -->
        <LinearLayout
            android:id="@+id/tabPesanan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_orders_24"
                android:contentDescription="Pesanan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesanan"
                android:textSize="10sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 4: Akun -->
        <LinearLayout
            android:id="@+id/tabAkun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile_24"
                android:contentDescription="Akun" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akun"
                android:textSize="10sp"
                android:textColor="@color/gadoca_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
