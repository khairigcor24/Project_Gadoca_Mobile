<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gadoca_surface"
    tools:context=".MainActivity">

    <!-- Top Immersive Banner Image -->
    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="0dp"
        android:layout_height="330dp"
        android:src="@drawable/img_coffee_banner"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/app_name" />

    <!-- Dark Gradient / Tint Overlay for top banner -->
    <View
        android:layout_width="0dp"
        android:layout_height="330dp"
        android:background="#33000000"
        app:layout_constraintTop_toTopOf="@id/imgBanner"
        app:layout_constraintBottom_toBottomOf="@id/imgBanner"
        app:layout_constraintStart_toStartOf="@id/imgBanner"
        app:layout_constraintEnd_toEndOf="@id/imgBanner" />

    <!-- Top Left: Logo & App Name (White on banner) -->
    <LinearLayout
        android:id="@+id/layoutTopBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/gambargadoca"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/white"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Floating Badge on Banner: "Kopi baik. Cerita hangat." -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_badge"
        android:textSize="12sp"
        android:textColor="@color/gadoca_text_dark"
        android:background="@drawable/bg_pill_white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="@id/imgBanner"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Content Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/imgBanner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Small Uppercase Tag -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_tag"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/gadoca_primary"
            android:layout_marginBottom="6dp" />

        <!-- Title Typography -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/gadoca_text_dark"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_desc"
            android:textSize="13sp"
            android:textColor="@color/gadoca_text_muted"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="14dp" />

        <!-- Page Indicator Dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_indicator_active"
                android:layout_marginEnd="6dp" />
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_indicator_inactive"
                android:layout_marginEnd="6dp" />
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_indicator_inactive" />
        </LinearLayout>

        <!-- Primary Button: Mulai menikmati -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/start_enjoying"
            android:textSize="15sp"
            android:textAllCaps="false"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/gadoca_primary"
            android:layout_marginBottom="10dp" />

        <!-- Text Link: Sudah punya akun? Masuk -->
        <TextView
            android:id="@+id/tvLoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/already_have_account"
            android:textSize="13sp"
            android:textColor="@color/gadoca_primary"
            android:textStyle="bold"
            android:padding="6dp"
            android:layout_marginBottom="8dp" />

        <!-- Web Intent Button: Kunjungi Web Kami -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWeb"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visit_our_web"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textColor="@color/gadoca_primary"
            android:layout_marginBottom="4dp" />

        <!-- Footer Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer_note"
            android:textSize="11sp"
            android:textColor="@color/gadoca_text_muted"
            android:gravity="center"
            android:paddingBottom="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
